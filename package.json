{
  "name": "amrutam-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-oriented telemedicine backend built with Express, TypeScript, and Drizzle.",
  "scripts": {
    "dev": "tsx watch src/bootstrap-api.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/bootstrap-api.js",
    "worker:dev": "tsx watch src/bootstrap-worker.ts",
    "worker:start": "node dist/src/bootstrap-worker.js",
    "admin:bootstrap": "tsx src/bootstrap-admin.ts",
    "admin:bootstrap:start": "node dist/src/bootstrap-admin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude dist/** --exclude test/integration/**",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:db": "docker compose up -d postgres-test",
    "test:e2e:services": "docker compose up -d --wait postgres-test redis",
    "test:e2e": "vitest run --config vitest.integration.config.ts test/integration/application.e2e.integration.test.ts",
    "observability:up": "docker compose --profile observability up -d otel-collector jaeger prometheus grafana",
    "observability:down": "docker compose --profile observability stop otel-collector jaeger prometheus grafana",
    "test:watch": "vitest",
    "openapi:generate": "tsx src/openapi/generate.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "argon2": "^0.44.0",
    "bullmq": "^6.4.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.1.2",
    "nodemailer": "^10.2.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.7",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.10"
  }
}
