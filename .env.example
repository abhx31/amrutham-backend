NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://amrutam:amrutam@localhost:5432/amrutam
# Optional privileged URL for the one-off migration process; falls back to DATABASE_URL locally.
# MIGRATION_DATABASE_URL=postgresql://amrutam_migrator:change-me@localhost:5432/amrutam
TEST_DATABASE_URL=postgresql://amrutam:amrutam@localhost:5433/amrutam_test
REDIS_URL=redis://localhost:6379
APP_PUBLIC_URL=http://localhost:3000
EMAIL_FROM=no-reply@amrutam.local
EMAIL_TRANSPORT=fake
# SMTP_URL=smtps://username:password@smtp.example.com:465
LOG_LEVEL=info
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=amrutam-api
JWT_AUDIENCE=amrutam-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Docker Compose mounts this into Prometheus as a secret; never copy the real value into prometheus.yml.
METRICS_BEARER_TOKEN=replace-with-at-least-32-random-characters
PAYMENT_GATEWAY_MODE=fake
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=5
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# One-off inputs for `npm run admin:bootstrap`; do not commit real credentials.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=Replace-With-A-Strong-Unique-Password-2026
# BOOTSTRAP_ADMIN_FIRST_NAME=Platform
# BOOTSTRAP_ADMIN_LAST_NAME=Admin
